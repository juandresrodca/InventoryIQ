# Copy to .env and fill in values. Never commit .env.

# ---- Grounding backend selector ----
# duckdb   -> local mock (default, no Azure required)
# foundry  -> Azure AI Foundry knowledge source backed by Azure AI Search
GROUNDING=duckdb

# ---- DuckDB (local mock) ----
DUCKDB_PATH=./inv.duckdb

# ---- Azure AI Foundry (the Microsoft IQ layer for this project) ----
AZURE_AI_FOUNDRY_ENDPOINT=
AZURE_AI_FOUNDRY_PROJECT=inventoryiq
AZURE_AI_FOUNDRY_KEY=

# ---- Azure AI Search (Foundry IQ grounding source) ----
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=inv-index
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_API_VERSION=2024-07-01

# ---- Azure OpenAI (the reasoning LLM the agent uses) ----
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_API_VERSION=2024-10-21
